*PPD-Adobe: "4.3"
*%
*% HP DesignJet 500 (24in) for macOS
*% Renders through Ghostscript's cdnj500 device (HP PCL3GUI raster).
*% Generated by make-ppd.sh -- edit that script, not this file.
*%
*FormatVersion: "4.3"
*FileVersion: "1.0"
*LanguageVersion: English
*LanguageEncoding: ISOLatin1
*PCFileName: "DNJ50024.PPD"
*Manufacturer: "HP"
*Product: "(HP DesignJet 500)"
*ModelName: "HP DesignJet 500 24in"
*ShortNickName: "HP DesignJet 500 24in"
*NickName: "HP DesignJet 500 24in (PCL3GUI via Ghostscript cdnj500)"
*PSVersion: "(3010.000) 0"
*LanguageLevel: "3"
*ColorDevice: True
*DefaultColorSpace: RGB
*FileSystem: False
*Throughput: "1"
*LandscapeOrientation: Plus90
*TTRasterizer: Type42
*1284DeviceID: "MFG:HP;MDL:DesignJet 500;CMD:PCL3GUI;"
*cupsVersion: 1.4
*cupsManualCopies: True
*cupsLanguages: "en"
*cupsFilter: "application/vnd.cups-pdf 0 /Library/Printers/cdnj500/filter/pdftocdnj500"

